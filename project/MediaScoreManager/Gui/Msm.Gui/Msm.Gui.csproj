<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>Msm.Gui</RootNamespace>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ApplicationManifest>Boot\app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <Page Remove="Boot\App.xaml" />
  </ItemGroup>
  <ItemGroup>
    <ApplicationDefinition Include="Boot\App.xaml" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.4" />
    <PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" Version="1.1.135" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Syncfusion.SfSkinManager.WPF" Version="29.1.40" />
    <PackageReference Include="Syncfusion.Themes.MaterialDark.WPF" Version="29.1.40" />
    <PackageReference Include="Syncfusion.Themes.MaterialDarkBlue.WPF" Version="29.1.40" />
    <PackageReference Include="Syncfusion.Themes.MaterialLight.WPF" Version="29.1.40" />
    <PackageReference Include="Syncfusion.Themes.MaterialLightBlue.WPF" Version="29.1.40" />
    <PackageReference Include="Syncfusion.Themes.Office2019Black.WPF" Version="29.1.40" />
    <PackageReference Include="Syncfusion.Themes.Office2019Colorful.WPF" Version="29.1.40" />
    <PackageReference Include="Syncfusion.Themes.Office2019DarkGray.WPF" Version="29.1.40" />
    <PackageReference Include="Syncfusion.Themes.Office2019HighContrast.WPF" Version="29.1.40" />
    <PackageReference Include="Syncfusion.Themes.Office2019White.WPF" Version="29.1.40" />
    <PackageReference Include="Syncfusion.Themes.Windows11Dark.WPF" Version="29.1.40" />
    <PackageReference Include="Syncfusion.Themes.Windows11Light.WPF" Version="29.1.40" />
    <PackageReference Include="Syncfusion.Tools.WPF" Version="29.1.40" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Assets\Internationalization\Translations.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Translations.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Assets\Internationalization\Translations.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>Translations.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <None Update="Assets\Settings\appsettings.dev.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Assets\Settings\appsettings.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Features\ApplicationFeature\Application\Contract\" />
    <Folder Include="Features\ApplicationFeature\Application\ViewModels\" />
    <Folder Include="Features\ApplicationFeature\Application\Views\" />
    <Folder Include="Features\InternationalizationFeature\Internationalization\Contract\" />
    <Folder Include="Features\InternationalizationFeature\Internationalization\ViewModels\" />
    <Folder Include="Features\InternationalizationFeature\Internationalization\Views\" />
    <Folder Include="Features\MainFeature\Main\Contract\" />
    <Folder Include="Features\RightPaneFeature\RightPane\ViewModels\" />
    <Folder Include="Features\RightPaneFeature\RightPane\Views\" />
    <Folder Include="Features\ShellFeature\ShellDialog\Services\" />
    <Folder Include="Features\ShellFeature\Shell\Services\" />
    <Folder Include="Features\_FeatureTemplate\Feature\Contract\" />
    <Folder Include="Features\_FeatureTemplate\Feature\Services\" />
    <Folder Include="Features\_FeatureTemplate\Feature\ViewModels\" />
    <Folder Include="Features\_FeatureTemplate\Feature\Views\" />
    <Folder Include="Infrastructure\Configuration\Models\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\Msm.Core.Logging.NLog\Msm.Core.Logging.NLog.csproj" />
    <ProjectReference Include="..\..\Core\Msm.Core.Wpf\Msm.Core.Wpf.csproj" />
    <ProjectReference Include="..\..\Core\Msm.Core\Msm.Core.csproj" />
  </ItemGroup>
</Project>
