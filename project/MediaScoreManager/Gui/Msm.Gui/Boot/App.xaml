<Application
    x:Class="Msm.Gui.Boot.App"
    x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Startup="OnStartup"
    Exit="OnExit"
    DispatcherUnhandledException="OnDispatcherUnhandledException">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/View/Styles/Common/_Thickness.xaml" />
                <ResourceDictionary Source="/View/Styles/Common/_FontFamily.xaml" />
                <ResourceDictionary Source="/View/Styles/Windows/MetroWindow.xaml" />
                <ResourceDictionary Source="/View/Styles/Controls/TextBlock.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
