<syncfusion:ChromelessWindow
    x:Class="Msm.Gui.Features.ShellFeature.ShellDialog.Views.ShellDialogWindow"
    x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:syncfusion="clr-namespace:Syncfusion.Windows.Shared;assembly=Syncfusion.Shared.WPF"
    xmlns:viewModels="clr-namespace:Msm.Gui.Features.ShellFeature.ShellDialog.ViewModels"
    mc:Ignorable="d"
    Style="{StaticResource CustomMetroWindow}"
    d:DataContext="{d:DesignInstance Type=viewModels:ShellDialogViewModel, IsDesignTimeCreatable=True}"
    >
    <syncfusion:ChromelessWindow.Content>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Frame
                x:Name="FDialogFrame"
                Focusable="False"
                NavigationUIVisibility="Hidden" />

            <Button
                Grid.Row="1"
                Content="Close"
                HorizontalAlignment="Right"
                Command="{Binding CmdClose}"
                Width="200"
                Margin="{StaticResource SmallLeftTopRightBottomMargin}" />
        </Grid>
    </syncfusion:ChromelessWindow.Content>
</syncfusion:ChromelessWindow>
